@{
    ViewData["title"] = "Home Page";
}

<div class="container" id="welcome-area">
    <h1>BlendMaster</h1>
    <p>Make an order or discover new and exciting drink recipes through our chatbot!</p>

    <a href="@Url.Action("Table", "Home")" class="btn btn-primary">Choose Your Table</a>
    <a href="@Url.Action("Index", "Chat")" class="btn btn-secondary">Chatbot</a>
    <br />
</div>

@section Styles {
    <style>
        body {
            background: url('/images/background_home.JPG') no-repeat center center fixed;
            background-size: cover;
        }

        #welcome-area {
            text-align: center;
            padding: 50px;
            background: rgba(255, 255, 255, 0.8); /* Semi-transparent white background */
            border-radius: 10px;
            max-width: 600px;
            margin: 100px auto;
        }
    </style>
}

@section Scripts {
    <script>
        $(function () {
            let userName = localStorage.getItem('loggedUser');
            let token = localStorage.getItem('jwtToken');

            if (userName) {
                const adminLink = document.createElement("a");
                adminLink.href = "admin/index";
                adminLink.textContent = "Go to admin panel";
                document.getElementById("welcome-area").appendChild(adminLink);
            }

            fetch('account/validatetoken', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${token}`
                },
                body: JSON.stringify({ token })
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        console.log('success')
                    } else {
                        console.log('fail')
                    }
                })
        })
    </script>
}
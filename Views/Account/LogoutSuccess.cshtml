<h3>You have successfully logged out.</h3>
<p>You will be redirected to the homepage shortly.</p>

@section Scripts {
    <script>
        $(function () {
            localStorage.removeItem('loggedUser');
            localStorage.removeItem('jwtToken');
            setTimeout(function () {
                window.location.href = '@Url.Action("Index", "Home")';
            }, 2000);
        })
    </script>
}
@model WebApplication2.Entities.Bill

@{
    ViewData["Title"] = "Bill Detail";
}

<div class="container mt-5">
    <table class="table table-striped table-bordered">
        <thead class="thead-dark">
            <tr>
                <th>Bill ID</th>
                <th>Table ID</th>
                <th>Bill Date</th>
                <th>Total</th>
                <th>Tax</th>
                <th>Total Paid</th>
                <th>Payment Method</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
                <tr>
                    <td>@Model.BillId</td>
                    <td>@Model.TableId</td>
                    <td>@Model.BillDate.ToString("yyyy-MM-dd")</td>
                    <td>@Model.TotalAmount</td>
                    <td>@Model.Tax</td>
                    <td>@Model.AmountPaid</td>
                    <td>@Model.PaymentMethod</td>
                    <td>@Model.Status</td>
                </tr>
        </tbody>
    </table>
</div>

<style>
    .bar-image {
        position: relative;
        width: 100%;
        height: 200px;
        overflow: hidden;
    }

        .bar-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
</style>

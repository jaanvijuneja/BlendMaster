@model List<OngoingOrdersViewModel>

@{
    ViewData["Title"] = "Ongoing Orders";
}

<div class="container mt-5">
    <table class="table table-striped table-bordered">
        <thead class="thead-dark">
            <tr>
                <th>Order ID</th>
                <th>Order Date</th>
                <th>Order Items</th>
                <th>Order Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.OrderId</td>
                    <td>@order.CreatedDate.ToString("yyyy-MM-dd")</td>
                    <td>
                        @foreach (var product in order.Products)
                        {
                            <span class="badge badge-primary text-black">@product</span>
                        }
                    </td>
                    <td>@order.OrderStatus</td>
                    <td>
                        <a href="#">complete</a>
                        <span>|</span>
                        <a href="#">cancel</a>
                        <span>|</span>
                        <a href="#">recipe</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<h3>You have successfully logged in.</h3>
<p>You will be redirected to the homepage shortly.</p>

@section Scripts {
    <script>
        $(function () {
            localStorage.setItem('loggedUser', '@TempData["UserName"]');
            localStorage.setItem('jwtToken', '@TempData["Token"]');
            setTimeout(function () {
                window.location.href = '@Url.Action("Index", "Admin")';
            }, 2000);
        });
    </script>
}